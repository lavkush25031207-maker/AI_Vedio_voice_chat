# Optional AI provider keys (configure at least one provider for AI responses)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_API_KEY=

# Optional generic OpenAI-compatible provider
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# SQLite is used by default. Uncomment to use MySQL.
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/talkflow

# Set to 1 to allow local fallback responses when no AI provider is available.
ALLOW_LOCAL_TUTOR_FALLBACK=0
